# ===== KONFIGURASI OLT HIOSO =====
OLT_HOST=192.168.1.1        # IP OLT Hioso Anda
OLT_PORT=22                  # Port SSH OLT (default 22)
OLT_USER=admin               # Username SSH OLT
OLT_PASS=admin               # Password SSH OLT
OLT_PROMPT=#                 # Prompt OLT setelah login (biasanya # atau >)
OLT_ENABLE_CMD=enable        # Command masuk mode enable (kosongkan jika tidak perlu)
OLT_ENABLE_PASS=            # Password enable (kosongkan jika tidak ada)

# ===== KONFIGURASI SERVER =====
PORT=3000                    # Port backend API
API_KEY=ganti-dengan-kunci-rahasia-anda  # Kunci akses API (buat sendiri)

# ===== CORS =====
ALLOWED_ORIGIN=https://sabila07.github.io  # Domain frontend yang diizinkan
